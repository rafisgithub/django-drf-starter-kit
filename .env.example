# ==========================================
# Core Django
# ==========================================
DEBUG=True

CROSS_ORIGIN_DEVELOPMENT=True

# Required in production (DEBUG=False). Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-this-in-production

# Comma-separated. In production set your real domain(s), e.g. example.com,www.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated allowlist of frontend origins (production only; used when DEBUG=False).
# e.g. https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

# Comma-separated origins trusted for CSRF (scheme required).
CSRF_TRUSTED_ORIGINS=https://localhost,https://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173

# Cookie policy for non cross-origin production deployments.
# Use SameSite=Lax (default) for same-origin SPAs; set None (with HTTPS) only for cross-site cookies.
COOKIE_SAMESITE=Lax
COOKIE_SECURE=True

# Production TLS hardening (enable once HTTPS is terminated in front of the app).
# Turning SECURE_SSL_REDIRECT on without TLS in front will cause redirect loops.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
# Set True when behind a reverse proxy / load balancer that sends X-Forwarded-Proto.
USE_X_FORWARDED_PROTO=False

# ==========================================
# Database (PostgreSQL — only used when DEBUG=False; SQLite is used in DEBUG)
# ==========================================
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME="startup"
DATABASE_USER="postgres"
DATABASE_PASSWORD="root"
DATABASE_HOST="127.0.0.1"
DATABASE_PORT="5432"
REDIS_PORT=6379

# ==========================================
# Email (SMTP) — never commit real credentials
# ==========================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@example.com

# ==========================================
# Social Auth
# ==========================================
GOOGLE_CLIENT_ID="Google_Client_ID_here"
GOOGLE_SECRET_KEY="Google_Secret_Key_here"

# ==========================================
# Stripe payment configuration
# ==========================================
# Sandbox / test mode
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Live mode
#STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
#STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key
#STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
